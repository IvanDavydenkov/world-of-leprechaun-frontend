# Development: leave empty to use Vite same-origin proxy on localhost:5173.
VITE_API_ORIGIN=
USERS_API_ORIGIN=http://127.0.0.1:8080
# Docker behind host Nginx. VITE_API_ORIGIN is baked into JS at build time.
HTTP_PORT=8082
HTTP_BIND_ADDRESS=127.0.0.1
BACKEND_NETWORK=backend-word-of-leprechaun_default